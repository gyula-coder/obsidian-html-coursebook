{
  "name": "obsidian-html-coursebook",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Treat local HTML course folders as single documents in Obsidian.",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "lint": "eslint . --max-warnings=0",
    "validate": "npm run lint && npm run check && npm test && npm run build && node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gyula-coder/obsidian-html-coursebook.git"
  },
  "bugs": {
    "url": "https://github.com/gyula-coder/obsidian-html-coursebook/issues"
  },
  "homepage": "https://github.com/gyula-coder/obsidian-html-coursebook#readme"
}
